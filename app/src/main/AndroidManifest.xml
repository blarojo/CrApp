<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reminders (docs/future-features.md spec 6): required on Android 13+ (API 33+)
         to post the "no movement logged" notification; requested at runtime from
         SettingsScreen when the reminder toggle is turned on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Pre-scoped-storage devices (Android 9 and below) writing into the shared
         Pictures/CrApp album (docs/future-features.md's photo-attachment spec);
         ignored on Android 10+, where MediaStore needs no such permission. Best-
         effort/untested on a device this old; the primary target is Android 10+. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:name=".CrAppApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CrApp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CrApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Backs CSV export (docs/development-plan.md §8): hands exported files to the
          share sheet via content:// URIs instead of requesting broad storage
          permissions for a plain file:// share.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Wear OS companion app sync (docs/future-features.md spec 5): receives
             the watch's "log a movement" message over the Wearable Data Layer API. -->
        <service
            android:name=".wear.PhoneWearableListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/crapp/log_movement"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

</manifest>
